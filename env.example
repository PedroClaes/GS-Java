# Copie para .env (nao versionado) ou configure no Render > Environment.
# Nenhum destes valores pode ir para o repositorio.

DB_URL=jdbc:postgresql://localhost:5432/consertaai
DB_USERNAME=consertaai
DB_PASSWORD=consertaai

# Mesmo segredo, issuer e audience da API .NET (minimo 32 caracteres)
JWT_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
JWT_ISSUER=consertaai
JWT_AUDIENCE=consertaai-app

# RabbitMQ compartilhado com a API .NET (local: amqp://guest:guest@localhost:5672)
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# IA generativa (Spring AI). Sem chave, a triagem usa as regras de fallback.
# Groq (gratuito): AI_BASE_URL=https://api.groq.com/openai  AI_MODEL=llama-3.3-70b-versatile
# ChatGPT:         AI_BASE_URL=https://api.openai.com       AI_MODEL=gpt-4o-mini
# DeepSeek:        AI_BASE_URL=https://api.deepseek.com     AI_MODEL=deepseek-v4-flash
AI_API_KEY=
AI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4o-mini
